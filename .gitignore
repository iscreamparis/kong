# Rust
/target/
Cargo.lock
# build/ holds generated installers (.exe) — ignore those, but KEEP the NSIS
# source script tracked (same pattern as .github/* + !.github/workflows below).
build/*
!build/kong-installer.nsi

# Release output
/dist/
# OS
.DS_Store
Thumbs.db

# Editor
.vscode/settings.json
*.code-workspace
*.suo
*.user


# Ignore local .github notes/instructions, but keep CI workflows tracked.
.github/*
!.github/workflows/
!.github/workflows/**

# Test artifacts
/test/

# Local notes
agents.md
kong.rules
